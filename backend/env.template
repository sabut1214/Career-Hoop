# Environment Variables Template
# Copy this file to .env in the backend directory and fill in your actual values
# The .env file is gitignored and will not be committed to version control

# ============================================
# Email Configuration (Required for Password Reset)
# ============================================
# SMTP Server Configuration
# For Brevo (recommended): smtp.brevo.com
# For Gmail: smtp.gmail.com
# For Mailtrap (testing): smtp.mailtrap.io
# For Outlook: smtp.office365.com
# For SendGrid: smtp.sendgrid.net
MAIL_HOST=smtp.brevo.com

# SMTP Port (587 for TLS, 465 for SSL, 25 for plain)
MAIL_PORT=587

# SMTP Username
# For Brevo: Your SMTP login (usually your email) - find in Brevo dashboard > SMTP & API > SMTP tab
# For Gmail: Your email address
# For SendGrid: use "apikey"
# For other providers: Usually your email address
MAIL_USERNAME=your-brevo-smtp-login@example.com

# SMTP Password
# For Brevo: Your SMTP key - find in Brevo dashboard > SMTP & API > SMTP tab
#   Get from: https://app.brevo.com/settings/keys/api
# For Gmail: Use an App Password (not your regular password)
#   Generate from: Google Account > Security > 2-Step Verification > App passwords
# For other providers: Use your email password or app-specific password
MAIL_PASSWORD=your-brevo-smtp-key-here

# Frontend URL (used to generate password reset links in emails)
# Local development: http://localhost:5173
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# ============================================
# AI Service Configuration (OpenRouter)
# ============================================
# OpenRouter API Key
# Get your API key from: https://openrouter.ai/settings/keys
AI_API_KEY=your_openrouter_api_key_here

# Optional: Custom API base URL (defaults to https://openrouter.ai/api/v1)
# AI_API_BASE_URL=https://openrouter.ai/api/v1

# Optional: HTTP-Referer for OpenRouter (your app URL)
# AI_API_HTTP_REFERER=https://your-app-url.com

# Optional: X-Title for OpenRouter (your app name)
# AI_API_X_TITLE=CareerHoop

# Optional: Model to use (defaults to qwen/qwen-2.5-72b-instruct:free)
# For vision/OCR tasks, consider using: openai/gpt-4o or openai/gpt-4-vision-preview
# AI_API_MODEL=qwen/qwen-2.5-72b-instruct:free

# ============================================
# Security Configuration (REQUIRED for Production)
# ============================================
# JWT Secret Key (REQUIRED for production - use a secure random 256-bit key)
# Generate with: openssl rand -base64 32
# DO NOT use the default value in production!
JWT_SECRET=your-256-bit-secret-key-here

# Admin Account (optional, defaults in application.properties)
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=your-secure-password

# ============================================
# Database Configuration (Optional - for Flyway Maven plugin)
# ============================================
# Database connection for Flyway migrations
# DB_USERNAME=careerhoop
# DB_PASSWORD=your-database-password

# ============================================
# CORS Configuration (REQUIRED for Production)
# ============================================
# Comma-separated list of allowed frontend origins
# Production example: APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Development: APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# CSRF Configuration (Optional)
# ============================================
# Enable CSRF protection (default: true, set to false only for local development)
# APP_CSRF_ENABLED=true

# ============================================
# eSewa Payment Gateway (Optional)
# ============================================
# For eSewa UAT:
#   ESEWA_MERCHANT_CODE=EPAYTEST
#   ESEWA_PAYMENT_URL=https://uat.esewa.com.np/epay/main
#   ESEWA_VERIFY_URL=https://uat.esewa.com.np/epay/transrec
#
# For live:
#   ESEWA_MERCHANT_CODE=<your_merchant_code>
#   ESEWA_PAYMENT_URL=https://esewa.com.np/epay/main
#   ESEWA_VERIFY_URL=https://esewa.com.np/epay/transrec
#
# IMPORTANT: These callback URLs must be publicly reachable by eSewa.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_PAYMENT_URL=https://uat.esewa.com.np/epay/main
ESEWA_VERIFY_URL=https://uat.esewa.com.np/epay/transrec
ESEWA_SUCCESS_URL=http://localhost:8080/api/payments/esewa/success
ESEWA_FAILURE_URL=http://localhost:8080/api/payments/esewa/failure
ESEWA_FRONTEND_RETURN_URL=http://localhost:5173/payment/esewa/return

# ============================================
# eSewa ePay V2 Payment Gateway Configuration (Optional)
# ============================================
# Environment: uat or prod
# ESEWA_V2_ENV=uat
# 
# Product code (EPAYTEST for UAT, or your actual product code for production)
# ESEWA_V2_PRODUCT_CODE=EPAYTEST
# 
# Secret key for signature generation (REQUIRED for V2)
# Get this from your eSewa merchant dashboard
# ESEWA_V2_SECRET_KEY=your-secret-key-here
# 
# Frontend redirect URLs (after payment completion)
# ESEWA_V2_SUCCESS_URL=http://localhost:5173/payment/esewa/success
# ESEWA_V2_FAILURE_URL=http://localhost:5173/payment/esewa/failure

# ============================================
# Database Configuration (REQUIRED for Production)
# ============================================
# JPA ddl-auto setting
# For production: JPA_DDL_AUTO=validate (validates schema, fails if mismatch)
# For development: JPA_DDL_AUTO=update (updates schema automatically)
# NEVER use 'update', 'create', or 'create-drop' in production!
# JPA_DDL_AUTO=validate

# Show SQL queries in logs (set to false in production)
# JPA_SHOW_SQL=false
